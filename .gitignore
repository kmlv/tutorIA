.DS_Store

# audio efimero: MP3 con TTL de 2 dias (ver scripts/audio-gc.sh).
# Los transcripts .md permanentes viven en docs/audio/ y SI se versionan.
.audio/

# media generada por el pipeline: se reconstruye con pipeline/cues.py
#
# EXCEPTO el audio de la lección. Estaba ignorado como "artefacto de compilación" y no lo
# es: la `timeline.json` que SÍ está versionada contiene los segundos exactos de cada cue,
# medidos contra ESE archivo de audio. Regenerarlo con TTS da otra duración y otros
# tiempos, así que el par audio+timeline solo es coherente si viajan juntos. Además sin él
# no se puede desplegar desde un git push: el contenedor arrancaría sin voz.
#
# Son 3,5 MB entre los dos idiomas.
content/packs/*/media/*.mp3
!content/packs/*/media/*budget-line-es.mp3
!content/packs/*/media/*budget-line-en.mp3
# el MP4 de la opcion B: lo reconstruye pipeline/render_b.py, y son 11 MB por idioma
content/packs/*/media/*.mp4
content/packs/*/media/*.player.html
content/packs/*/media/audio-library.html
content/packs/*/media/_clean.*.md

# entorno y datos locales
# .env lleva la API key del proveedor: NUNCA se versiona (decision 20).
.env
.venv/
data/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
app/web/dist/

# salida del compilador para los tests de node del cue engine
app/web/dist-test/

# Video ingest workspace (source media stays out of Git; see content/courses/*/manifest.json)
workspace/
