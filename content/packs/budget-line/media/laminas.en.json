   "dice": [
    [
     {
      "t": "The Budget Constraint"
     }
    ],
    [
     {
      "t": "Before we talk about budgets, we have to say what it is that we are choosing."
     }
    ],
    [
     {
      "t": "A consumer does not choose one good: they choose a combination of everything they consume."
     }
    ],
    [
     {
      "t": "The set of all imaginable combinations is what we call the consumption set."
     }
    ],
    [
     {
      "t": "And what keeps you from reaching any of them is not desire, it is resources: income, time, whatever happens to be limited."
     }
    ]
   ],
   "escena": {
