   "dice": [
    [
     {
      "t": "La pendiente es menos p uno sobre p dos, es decir, menos tres."
     }
    ],
    [
     {
      "t": "Ese número no es abstracto: significa que para llevarte un kilo más de café, tienes que renunciar a tres litros de jugo."
     }
    ],
    [
     {
      "t": "El mercado te deja transformar tres litros de jugo en un kilo de café, a los precios actuales."
     }
    ],
    [
