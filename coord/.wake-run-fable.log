ype":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1203,"cache_read_input_tokens":79480,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1203},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6e0c120b-a5bb-4018-a86c-097ba5653a5d","uuid":"5d97d16c-299e-40c6-b004-fbe6e57c7727","timestamp":"2026-08-10T18:08:50.283Z","request_id":"req_011CduWpPgpaps9qVkgY38j5"}
