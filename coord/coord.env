# coord.env — per-project wake defaults, auto-loaded by coord-pulse / coord-wake-all.
# Set the smart defaults ONCE here and you never pass flags. Only COORD_*=value
# lines are read; the file is NEVER executed (no eval). Your shell environment and
# command flags override anything here. See docs/CONFIG.md.
#
# Everything is OFF by default (lines commented) — a fresh repo behaves predictably.
# Turn on the recommended "intelligent & efficient" profile with `bootstrap --efficient`,
# or by uncommenting the block below (bias to intelligence, cheap only where safe;
# measured ~-66% tokens / ~-76% wall-clock on a trivial wake — docs/PERF.md).

# Classify every wake; default to the strong model, fast only when provably trivial.
COORD_WAKE_POLICY=intelligence

# Embed coordination context in the wake prompt instead of "Read coord/…" (fewer
# tokens, fewer turns).
COORD_PUSH_CONTEXT=1

# Resume a warm CLI session when the gate proves it safe (skips the cold-boot reread).
# Claude headless resume stays OFF unless COORD_RESUME_CLAUDE=1 (measured no savings).
COORD_RESUME=1

# Record per-wake tokens (+ USD for claude) into coord/trace.jsonl.
COORD_CAPTURE_TOKENS=1

# Optional fast-tier model for agy (a Gemini display name from your antigravity
# settings). Without it, agy wakes fail-safe to the strong model instead of fast.
#COORD_WAKE_AGY_MODEL="Gemini 3.5 Flash (High)"
