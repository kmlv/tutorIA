{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba app/server/core/judge/deterministic.py | sed -n '1,280p'\nnl -ba app/server/core/content/schema.py | sed -n '1,360p'\nnl -ba tests/test_graders.py | sed -n '1,360p'\nrg -n \\\"q_slope_numeric|q_feas_manip|q_cs_m_manip|q_cs_p_manip|expresion|misconception|verificacion|aciertos_consecutivos|max_evidencias\\\" content/packs/budget-line app/server/core -g '*.yaml' -g '*.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba app/server/core/judge/deterministic.py | sed -n '1,280p'\nnl -ba app/server/core/content/schema.py | sed -n '1,360p'\nnl -ba tests/test_graders.py | sed -n '1,360p'\nrg -n \\\"q_slope_numeric|q_feas_manip|q_cs_m_manip|q_cs_p_manip|expresion|misconception|verificacion|aciertos_consecutivos|max_evidencias\\\" content/packs/budget-line app/server/core -g '*.yaml' -g '*.py'\"","aggregated_output":"     1\t\"\"\"Graders deterministas: numéricas, opción múltiple y manipulación del gráfico.\n     2\t\n     3\tDeterministic-first (C7): el LLM sólo juzga respuestas abiertas, y eso llega en M3.\n     4\tAquí no se invoca ningún modelo. Estos tres graders son los que sostienen el criterio\n     5\tde dominio, porque el juez LLM aporta como mucho 1 de las 3 evidencias.\n     6\t\n     7\t*(Desviación menor del PLAN §2.3, que listaba `grader_numeric.py`, `grader_mcq.py` y\n     8\t`grader_manip.py` por separado: van juntos porque comparten el evaluador de expresiones\n     9\ty suman menos de 200 líneas. `grader_open.py` sí irá aparte, porque tiene proveedor,\n    10\tprompt versionado y modo sombra.)*\n    11\t\"\"\"\n    12\tfrom __future__ import annotations\n    13\t\n    14\timport ast\n    15\timport operator\n    16\tfrom dataclasses import dataclass, field\n    17\tfrom typing import Any\n    18\t\n    19\tfrom ..content.schema import Ejemplo, Question\n    20\t\n    21\t_OPS = {\n    22\t    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,\n    23\t    ast.Div: operator.truediv, ast.Pow: operator.pow, ast.USub: operator.neg,\n    24\t    ast.UAdd: operator.pos,\n    25\t}\n    26\t\n    27\t\n    28\tdef eval_expr(expr: str, params: dict[str, float]) -> float:\n    29\t    \"\"\"Evalúa `m / p2`, `-p1 / p2`, `(m - p1*12) / p2`.\n    30\t\n    31\t    Con `ast` y una lista blanca de operadores en vez de `eval`: estas expresiones\n    32\t    vienen de archivos de contenido que algún día podría emitir un LLM, así que no\n    33\t    pueden ser código arbitrario.\n    34\t    \"\"\"\n    35\t    def walk(node: ast.AST) -> float:\n    36\t        if isinstance(node, ast.Expression):\n    37\t            return walk(node.body)\n    38\t        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):\n    39\t            return float(node.value)\n    40\t        if isinstance(node, ast.Name):\n    41\t            if node.id not in params:\n    42\t                raise ValueError(f\"variable desconocida: {node.id}\")\n    43\t            return float(params[node.id])\n    44\t        if isinstance(node, ast.BinOp) and type(node.op) in _OPS:\n    45\t            return _OPS[type(node.op)](walk(node.left), walk(node.right))\n    46\t        if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:\n    47\t            return _OPS[type(node.op)](walk(node.operand))\n    48\t        raise ValueError(f\"expresión no permitida: {ast.dump(node)}\")\n    49\t\n    50\t    return walk(ast.parse(expr, mode=\"eval\"))\n    51\t\n    52\t\n    53\t@dataclass\n    54\tclass Veredicto:\n    55\t    correcta: bool\n    56\t    score: float\n    57\t    misconception_id: str | None = None\n    58\t    esperado: Any = None\n    59\t    detalle: dict = field(default_factory=dict)\n    60\t\n    61\t\n    62\tdef _params(e: Ejemplo) -> dict[str, float]:\n    63\t    return {\"p1\": e.p1, \"p2\": e.p2, \"m\": e.m}\n    64\t\n    65\t\n    66\t# --- numéricas --------------------------------------------------------------\n    67\t\n    68\tdef grade_numeric(q: Question, raw: str, e: Ejemplo) -> Veredicto:\n    69\t    try:\n    70\t        dado = float(str(raw).replace(\",\", \".\").strip())\n    71\t    except ValueError:\n    72\t        return Veredicto(False, 0.0, detalle={\"error\": \"no es un número\"})\n    73\t\n    74\t    spec = q.respuesta or {}\n    75\t    esperado = eval_expr(spec[\"expr\"], _params(e))\n    76\t    tol = float(spec.get(\"tolerancia\", 0.01))\n    77\t    if abs(dado - esperado) <= tol:\n    78\t        return Veredicto(True, 1.0, esperado=esperado)\n    79\t\n    80\t    # ¿el error coincide con una confusión conocida? Eso es lo que hace diagnóstico a\n    81\t    # un grader determinista, en vez de un simple corrector.\n    82\t    for expr, mid in (q.diagnostico_si_falla or {}).items():\n    83\t        if not isinstance(expr, str) or not mid:\n    84\t            continue\n    85\t        try:\n    86\t            alt = eval_expr(expr, _params(e))\n    87\t        except ValueError:\n    88\t            continue\n    89\t        if abs(dado - alt) <= tol:\n    90\t            return Veredicto(False, 0.0, misconception_id=mid, esperado=esperado,\n    91\t                             detalle={\"coincide_con\": expr})\n    92\t    return Veredicto(False, 0.0, esperado=esperado)\n    93\t\n    94\t\n    95\t# --- opción múltiple --------------------------------------------------------\n    96\t\n    97\tdef grade_mcq(q: Question, indice: int) -> Veredicto:\n    98\t    ops = q.opciones or []\n    99\t    if not isinstance(indice, int) or not 0 <= indice < len(ops):\n   100\t        return Veredicto(False, 0.0, detalle={\"error\": \"índice fuera de rango\"})\n   101\t    elegida = ops[indice]\n   102\t    correcto = next(i for i, o in enumerate(ops) if o.correcta)\n   103\t    if elegida.correcta:\n   104\t        return Veredicto(True, 1.0, esperado=correcto)\n   105\t    # cada distractor está mapeado a la confusión que delata\n   106\t    return Veredicto(False, 0.0, misconception_id=elegida.misconception, esperado=correcto)\n   107\t\n   108\t\n   109\t# --- manipulación del gráfico ----------------------------------------------\n   110\t\n   111\tdef grade_manip(q: Question, dado: dict, e: Ejemplo) -> Veredicto:\n   112\t    \"\"\"El cliente manda la recta que construyó el estudiante; aquí se decide.\n   113\t\n   114\t    El diagnóstico es DIRECCIONAL: no basta con decir \"está mal\", hay que distinguir\n   115\t    si rotó cuando debía desplazar (BL-M2) o desplazó cuando debía rotar (BL-M3).\n   116\t    \"\"\"\n   117\t    v = q.verificacion or {}\n   118\t    diag = q.diagnostico_si_falla or {}\n   119\t    p = _params(e)\n   120\t\n   121\t    if v.get(\"tipo\") == \"region\":\n   122\t        x1, x2 = float(dado.get(\"x1\", 0)), float(dado.get(\"x2\", 0))\n   123\t        gasto = e.p1 * x1 + e.p2 * x2\n   124\t        margen = float(v.get(\"margen\", 2.0))\n   125\t        if gasto < e.m - margen:\n   126\t            return Veredicto(True, 1.0, detalle={\"gasto\": gasto})\n   127\t        if abs(gasto - e.m) <= margen:\n   128\t            return Veredicto(False, 0.0, misconception_id=diag.get(\"sobre_la_recta\"),\n   129\t                             detalle={\"gasto\": gasto, \"por_que\": \"quedó sobre la recta\"})\n   130\t        return Veredicto(False, 0.0, detalle={\"gasto\": gasto, \"por_que\": \"no es alcanzable\"})\n   131\t\n   132\t    # tipo recta: se comparan pendiente e intercepto por separado, y la combinación de\n   133\t    # cuál falla es lo que identifica la confusión\n   134\t    pend_dada = -float(dado[\"p1\"]) / float(dado[\"p2\"])\n   135\t    int_dado = float(dado[\"m\"]) / float(dado[\"p2\"])\n   136\t\n   137\t    pend_esp = _num(v.get(\"pendiente_esperada\"), p)\n   138\t    int_esp = _num(v.get(\"intercepto_x2_esperado\"), p)\n   139\t    tol_p = float(v.get(\"tolerancia_pendiente\", 0.10))\n   140\t    tol_i = float(v.get(\"tolerancia_intercepto\", 3.0))\n   141\t\n   142\t    pend_ok = abs(pend_dada - pend_esp) <= abs(pend_esp) * tol_p\n   143\t    int_ok = abs(int_dado - int_esp) <= tol_i\n   144\t\n   145\t    if pend_ok and int_ok:\n   146\t        return Veredicto(True, 1.0)\n   147\t\n   148\t    detalle = {\"pendiente\": [pend_dada, pend_esp], \"intercepto_x2\": [int_dado, int_esp]}\n   149\t    if not pend_ok and int_ok:\n   150\t        # cambió la pendiente cuando no debía: giró en vez de desplazar\n   151\t        return Veredicto(False, 0.0, misconception_id=diag.get(\"pendiente_cambio\"),\n   152\t                         detalle=detalle | {\"por_que\": \"giró cuando debía desplazar\"})\n   153\t    if pend_ok and not int_ok:\n   154\t        return Veredicto(False, 0.0, misconception_id=diag.get(\"intercepto_x2_cambio\"),\n   155\t                         detalle=detalle | {\"por_que\": \"movió el intercepto que no cambia\"})\n   156\t    return Veredicto(False, 0.0, misconception_id=diag.get(\"desplazamiento_paralelo\"),\n   157\t                     detalle=detalle | {\"por_que\": \"pendiente e intercepto mal\"})\n   158\t\n   159\t\n   160\tdef _num(v: Any, params: dict[str, float]) -> float:\n   161\t    return eval_expr(v, params) if isinstance(v, str) else float(v)\n   162\t\n   163\t\n   164\t# --- despacho ---------------------------------------------------------------\n   165\t\n   166\tdef grade(q: Question, valor: Any, e: Ejemplo) -> Veredicto:\n   167\t    if q.modalidad == \"numeric\":\n   168\t        return grade_numeric(q, valor, e)\n   169\t    if q.modalidad == \"mcq\":\n   170\t        return grade_mcq(q, valor)\n   171\t    if q.modalidad == \"manip\":\n   172\t        return grade_manip(q, valor, e)\n   173\t    raise ValueError(f\"{q.id}: modalidad {q.modalidad} no es determinista\")\n     1\t\"\"\"Esquema tipado de un content pack.\n     2\t\n     3\tEl runtime consume SIEMPRE estos modelos y nunca sabe de dónde vinieron: hoy los\n     4\tproduce `FilesystemPackSource` leyendo `content/packs/<id>/`, mañana los producirá\n     5\t`GeneratedPackSource` a partir de un LLM. Ese es el punto de extensión del PLAN §2.2,\n     6\ty por eso los modelos viven aquí y no dentro del loader.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\tfrom typing import Literal\n    11\t\n    12\tfrom pydantic import BaseModel, Field, model_validator\n    13\t\n    14\tLang = Literal[\"es\", \"en\"]\n    15\tModalidad = Literal[\"numeric\", \"mcq\", \"open\", \"manip\"]\n    16\tGrader = Literal[\"deterministic\", \"llm\"]\n    17\t\n    18\t\n    19\tclass Localized(BaseModel):\n    20\t    \"\"\"Texto que debe existir en los dos idiomas. Sin `extra=forbid` a propósito:\n    21\t    añadir un tercer idioma no debe romper el esquema.\"\"\"\n    22\t\n    23\t    es: str\n    24\t    en: str\n    25\t\n    26\t\n    27\tclass Ejemplo(BaseModel):\n    28\t    bien_1: Localized\n    29\t    bien_2: Localized\n    30\t    p1: float\n    31\t    p2: float\n    32\t    m: float\n    33\t\n    34\t    @property\n    35\t    def pendiente(self) -> float:\n    36\t        return -self.p1 / self.p2\n    37\t\n    38\t    @property\n    39\t    def intercepto_x1(self) -> float:\n    40\t        return self.m / self.p1\n    41\t\n    42\t    @property\n    43\t    def intercepto_x2(self) -> float:\n    44\t        return self.m / self.p2\n    45\t\n    46\t\n    47\tclass SubSkill(BaseModel):\n    48\t    id: str\n    49\t    esencial: bool = True\n    50\t    umbral: float = 0.80\n    51\t    titulo: Localized\n    52\t    misconceptions: list[str] = Field(default_factory=list)\n    53\t    estado: str | None = None\n    54\t\n    55\t\n    56\tclass Checkpoint(BaseModel):\n    57\t    id: str\n    58\t    despues_de_cue: str\n    59\t    pregunta_ref: str\n    60\t\n    61\t\n    62\tclass Dominio(BaseModel):\n    63\t    \"\"\"Criterio de dominio del PLAN §3.2, endurecido tras T-002.\"\"\"\n    64\t\n    65\t    p_mastery_min: float = 0.80\n    66\t    aciertos_consecutivos: int = 3\n    67\t    modalidades_min: int = 2\n    68\t    sin_andamiaje_min: int = 1\n    69\t    max_evidencias_del_juez_llm: int = 1\n    70\t    sin_misconception_activa: bool = True\n    71\t\n    72\t    @model_validator(mode=\"after\")\n    73\t    def _coherente(self) -> Dominio:\n    74\t        if self.max_evidencias_del_juez_llm > self.aciertos_consecutivos:\n    75\t            raise ValueError(\n    76\t                \"max_evidencias_del_juez_llm no puede superar aciertos_consecutivos\"\n    77\t            )\n    78\t        if self.sin_andamiaje_min > self.aciertos_consecutivos:\n    79\t            raise ValueError(\n    80\t                \"sin_andamiaje_min no puede superar aciertos_consecutivos\"\n    81\t            )\n    82\t        return self\n    83\t\n    84\t\n    85\tclass Misconception(BaseModel):\n    86\t    id: str\n    87\t    nombre: Localized\n    88\t    subskills: list[str]\n    89\t    señal_observable: str\n    90\t    socratic_probe: Localized\n    91\t    representacion_alternativa: str\n    92\t    caso_numerico: str\n    93\t    distractor: Localized\n    94\t    nota: str | None = None\n    95\t\n    96\t\n    97\tclass Opcion(BaseModel):\n    98\t    es: str\n    99\t    en: str\n   100\t    correcta: bool = False\n   101\t    misconception: str | None = None\n   102\t\n   103\t\n   104\tclass Question(BaseModel):\n   105\t    id: str\n   106\t    subskill_primary: str\n   107\t    subskills_secundarias: list[str] = Field(default_factory=list)\n   108\t    tier: int = 1\n   109\t    modalidad: Modalidad\n   110\t    grader: Grader\n   111\t    andamiaje: bool = False\n   112\t    checkpoint: str | None = None\n   113\t    enunciado: Localized\n   114\t    opciones: list[Opcion] | None = None\n   115\t    respuesta: dict | None = None\n   116\t    verificacion: dict | None = None\n   117\t    key_points: list[dict] | None = None\n   118\t    misconceptions_vigilar: list[str] = Field(default_factory=list)\n   119\t    diagnostico_si_falla: dict | None = None\n   120\t\n   121\t    @model_validator(mode=\"after\")\n   122\t    def _forma_por_modalidad(self) -> Question:\n   123\t        if self.modalidad == \"mcq\":\n   124\t            if not self.opciones:\n   125\t                raise ValueError(f\"{self.id}: mcq sin opciones\")\n   126\t            n = sum(1 for o in self.opciones if o.correcta)\n   127\t            if n != 1:\n   128\t                raise ValueError(f\"{self.id}: {n} opciones correctas, debe ser exactamente 1\")\n   129\t        if self.modalidad == \"numeric\" and not self.respuesta:\n   130\t            raise ValueError(f\"{self.id}: numeric sin respuesta\")\n   131\t        if self.modalidad == \"manip\" and not self.verificacion:\n   132\t            raise ValueError(f\"{self.id}: manip sin verificacion\")\n   133\t        if self.modalidad == \"open\":\n   134\t            if not self.key_points:\n   135\t                raise ValueError(f\"{self.id}: abierta sin key_points\")\n   136\t            if self.grader != \"llm\":\n   137\t                raise ValueError(f\"{self.id}: abierta debe usar grader llm\")\n   138\t        elif self.grader != \"deterministic\":\n   139\t            raise ValueError(f\"{self.id}: {self.modalidad} debe usar grader deterministic\")\n   140\t        return self\n   141\t\n   142\t\n   143\tclass Cue(BaseModel):\n   144\t    id: str\n   145\t    type: Literal[\"graph\", \"checkpoint\"]\n   146\t    t: float | None = None\n   147\t    warning: str | None = None\n   148\t\n   149\t\n   150\tclass Timeline(BaseModel):\n   151\t    pack: str\n   152\t    lang: Lang\n   153\t    audio: str\n   154\t    duration_s: float\n   155\t    sync_granularity: str\n   156\t    cues: list[Cue]\n   157\t\n   158\t\n   159\tclass Pack(BaseModel):\n   160\t    \"\"\"Lo que consume el runtime. Un `Pack` completo y validado.\"\"\"\n   161\t\n   162\t    id: str\n   163\t    version: str\n   164\t    titulo: Localized\n   165\t    lang: list[Lang]\n   166\t    media_variant_default: str = \"A\"\n   167\t    ejemplo: Ejemplo\n   168\t    checkpoints: list[Checkpoint]\n   169\t    sub_skills: list[SubSkill]\n   170\t    dominio: Dominio\n   171\t    misconceptions: list[Misconception] = Field(default_factory=list)\n   172\t    questions: list[Question] = Field(default_factory=list)\n   173\t    timelines: dict[str, Timeline] = Field(default_factory=dict)\n   174\t\n   175\t    @model_validator(mode=\"after\")\n   176\t    def _integridad_referencial(self) -> Pack:\n   177\t        skill_ids = {s.id for s in self.sub_skills}\n   178\t        misc_ids = {m.id for m in self.misconceptions}\n   179\t        q_ids = {q.id for q in self.questions}\n   180\t        errs: list[str] = []\n   181\t\n   182\t        for s in self.sub_skills:\n   183\t            for mid in s.misconceptions:\n   184\t                if mid not in misc_ids:\n   185\t                    errs.append(f\"sub-skill {s.id} apunta al misconception inexistente {mid}\")\n   186\t        for m in self.misconceptions:\n   187\t            for sid in m.subskills:\n   188\t                if sid not in skill_ids:\n   189\t                    errs.append(f\"misconception {m.id} apunta a la sub-skill inexistente {sid}\")\n   190\t        for q in self.questions:\n   191\t            if q.subskill_primary not in skill_ids:\n   192\t                errs.append(f\"pregunta {q.id}: sub-skill {q.subskill_primary} no existe\")\n   193\t            citados = set(q.misconceptions_vigilar)\n   194\t            citados |= {v for v in (q.diagnostico_si_falla or {}).values() if v}\n   195\t            citados |= {o.misconception for o in (q.opciones or []) if o.misconception}\n   196\t            for mid in citados:\n   197\t                if mid not in misc_ids:\n   198\t                    errs.append(f\"pregunta {q.id} cita el misconception inexistente {mid}\")\n   199\t        for cp in self.checkpoints:\n   200\t            if cp.pregunta_ref not in q_ids:\n   201\t                errs.append(f\"checkpoint {cp.id}: pregunta_ref {cp.pregunta_ref} no está en el banco\")\n   202\t\n   203\t        # el criterio de dominio debe ser alcanzable con el banco que hay\n   204\t        for s in self.sub_skills:\n   205\t            if not s.esencial:\n   206\t                continue\n   207\t            mias = [q for q in self.questions if q.subskill_primary == s.id]\n   208\t            mods = {q.modalidad for q in mias}\n   209\t            det = [q for q in mias if q.grader == \"deterministic\"]\n   210\t            if mods and len(mods) < self.dominio.modalidades_min:\n   211\t                errs.append(\n   212\t                    f\"sub-skill {s.id}: {len(mods)} modalidad(es) en el banco, \"\n   213\t                    f\"el dominio exige {self.dominio.modalidades_min}\"\n   214\t                )\n   215\t            necesarias = self.dominio.aciertos_consecutivos - self.dominio.max_evidencias_del_juez_llm\n   216\t            if mias and len(det) < necesarias:\n   217\t                errs.append(\n   218\t                    f\"sub-skill {s.id}: {len(det)} ítem(s) determinista(s), hacen falta \"\n   219\t                    f\"{necesarias} porque el juez LLM aporta como mucho \"\n   220\t                    f\"{self.dominio.max_evidencias_del_juez_llm}\"\n   221\t                )\n   222\t\n   223\t        if errs:\n   224\t            raise ValueError(\"pack incoherente:\\n  - \" + \"\\n  - \".join(errs))\n   225\t        return self\n   226\t\n   227\t    def sub_skill(self, sid: str) -> SubSkill:\n   228\t        return next(s for s in self.sub_skills if s.id == sid)\n   229\t\n   230\t    def misconception(self, mid: str) -> Misconception:\n   231\t        return next(m for m in self.misconceptions if m.id == mid)\n   232\t\n   233\t    @property\n   234\t    def enum_misconceptions(self) -> list[str]:\n   235\t        \"\"\"El enum que ve el juez. Incluye los dos valores de escape.\n   236\t\n   237\t        Sin ellos el juez está obligado a emitir uno de los ids del catálogo aunque el\n   238\t        alumno no cometa ningún error, y el gate \"cero ids fuera de catálogo\" se pasa\n   239\t        por construcción. Hallazgo del carril C de T-002.\n   240\t        \"\"\"\n   241\t        return [m.id for m in self.misconceptions] + [\"NINGUNA\", \"FUERA_DE_CATALOGO\"]\n     1\t\"\"\"Los graders deterministas no solo corrigen: diagnostican.\n     2\t\n     3\tEs lo que sostiene la contingencia del PLAN R1 — si el juez LLM no pasa el gate de\n     4\tconcordancia, el diagnóstico se apoya solo en esto.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport pytest\n     9\t\n    10\tfrom app.server.core.content.loader import FilesystemPackSource\n    11\tfrom app.server.core.judge.deterministic import eval_expr, grade\n    12\t\n    13\t\n    14\t@pytest.fixture(scope=\"module\")\n    15\tdef pack():\n    16\t    return FilesystemPackSource().get_pack(\"budget-line\")\n    17\t\n    18\t\n    19\tdef q(pack, qid: str):\n    20\t    return next(x for x in pack.questions if x.id == qid)\n    21\t\n    22\t\n    23\t# ---- evaluador de expresiones ---------------------------------------------\n    24\t\n    25\tdef test_eval_expr_resuelve_las_del_banco() -> None:\n    26\t    p = {\"p1\": 3.0, \"p2\": 1.0, \"m\": 100.0}\n    27\t    assert eval_expr(\"m / p2\", p) == 100\n    28\t    assert eval_expr(\"-p1 / p2\", p) == -3\n    29\t    assert eval_expr(\"(m - p1*12) / p2\", p) == 64\n    30\t\n    31\t\n    32\tdef test_eval_expr_rechaza_codigo_arbitrario() -> None:\n    33\t    \"\"\"Estas expresiones vienen de archivos de contenido que algún día podría emitir un\n    34\t    LLM. No pueden ser código.\"\"\"\n    35\t    for malo in [\"__import__('os').system('ls')\", \"open('/etc/passwd')\", \"m.__class__\"]:\n    36\t        with pytest.raises(ValueError):\n    37\t            eval_expr(malo, {\"m\": 1.0})\n    38\t\n    39\t\n    40\t# ---- numéricas --------------------------------------------------------------\n    41\t\n    42\tdef test_numerica_correcta(pack) -> None:\n    43\t    v = grade(q(pack, \"q_int_numeric_1\"), \"100\", pack.ejemplo)\n    44\t    assert v.correcta and v.score == 1.0\n    45\t\n    46\t\n    47\tdef test_numerica_acepta_coma_decimal(pack) -> None:\n    48\t    \"\"\"Un estudiante hispanohablante escribe 33,3 y eso no es un error conceptual.\"\"\"\n    49\t    v = grade(q(pack, \"q_int_numeric_2\"), \"33,3\", pack.ejemplo)\n    50\t    assert v.correcta\n    51\t\n    52\t\n    53\tdef test_numerica_diagnostica_el_intercepto_cambiado(pack) -> None:\n    54\t    \"\"\"Responder 33.3 donde va 100 no es 'incorrecto y ya': es BL-M6.\"\"\"\n    55\t    v = grade(q(pack, \"q_int_numeric_1\"), \"33.33\", pack.ejemplo)\n    56\t    assert not v.correcta and v.misconception_id == \"BL-M6\"\n    57\t\n    58\t\n    59\tdef test_pendiente_invertida_es_BL_M1(pack) -> None:\n    60\t    v = grade(q(pack, \"q_slope_numeric\"), \"-0.333\", pack.ejemplo)\n    61\t    assert v.misconception_id == \"BL-M1\"\n    62\t\n    63\t\n    64\tdef test_pendiente_sin_signo_es_BL_M5(pack) -> None:\n    65\t    v = grade(q(pack, \"q_slope_numeric\"), \"3\", pack.ejemplo)\n    66\t    assert v.misconception_id == \"BL-M5\"\n    67\t\n    68\t\n    69\tdef test_numerica_no_numerica_no_revienta(pack) -> None:\n    70\t    v = grade(q(pack, \"q_slope_numeric\"), \"no sé\", pack.ejemplo)\n    71\t    assert not v.correcta and v.misconception_id is None\n    72\t\n    73\t\n    74\t# ---- opción múltiple --------------------------------------------------------\n    75\t\n    76\tdef test_mcq_correcta_y_distractor_diagnostico(pack) -> None:\n    77\t    qq = q(pack, \"q_slope_mcq\")\n    78\t    correcto = next(i for i, o in enumerate(qq.opciones) if o.correcta)\n    79\t    assert grade(qq, correcto, pack.ejemplo).correcta\n    80\t\n    81\t    invertida = next(i for i, o in enumerate(qq.opciones) if o.misconception == \"BL-M1\")\n    82\t    v = grade(qq, invertida, pack.ejemplo)\n    83\t    assert not v.correcta and v.misconception_id == \"BL-M1\"\n    84\t\n    85\t\n    86\tdef test_mcq_indice_invalido(pack) -> None:\n    87\t    assert not grade(q(pack, \"q_slope_mcq\"), 99, pack.ejemplo).correcta\n    88\t\n    89\t\n    90\t# ---- manipulación del gráfico ----------------------------------------------\n    91\t\n    92\tdef test_manip_region_interior_es_correcta(pack) -> None:\n    93\t    v = grade(q(pack, \"q_feas_manip\"), {\"x1\": 10, \"x2\": 20}, pack.ejemplo)\n    94\t    assert v.correcta  # gasta 50 de 100\n    95\t\n    96\t\n    97\tdef test_manip_sobre_la_recta_es_BL_M4(pack) -> None:\n    98\t    \"\"\"Quedarse sobre la recta cuando se pedía el interior delata que confunde la\n    99\t    línea con el conjunto.\"\"\"\n   100\t    v = grade(q(pack, \"q_feas_manip\"), {\"x1\": 20, \"x2\": 40}, pack.ejemplo)\n   101\t    assert not v.correcta and v.misconception_id == \"BL-M4\"\n   102\t\n   103\t\n   104\tdef test_manip_ingreso_correcto(pack) -> None:\n   105\t    v = grade(q(pack, \"q_cs_m_manip\"), {\"p1\": 3, \"p2\": 1, \"m\": 150}, pack.ejemplo)\n   106\t    assert v.correcta\n   107\t\n   108\t\n   109\tdef test_manip_giro_cuando_debia_desplazar_es_BL_M2(pack) -> None:\n   110\t    \"\"\"El diagnóstico es DIRECCIONAL: distingue rotar de desplazar.\"\"\"\n   111\t    v = grade(q(pack, \"q_cs_m_manip\"), {\"p1\": 1.5, \"p2\": 1, \"m\": 150}, pack.ejemplo)\n   112\t    assert not v.correcta and v.misconception_id == \"BL-M2\"\n   113\t    assert \"giró\" in v.detalle[\"por_que\"]\n   114\t\n   115\t\n   116\tdef test_manip_precio_correcto(pack) -> None:\n   117\t    v = grade(q(pack, \"q_cs_p_manip\"), {\"p1\": 4, \"p2\": 1, \"m\": 100}, pack.ejemplo)\n   118\t    assert v.correcta\n   119\t\n   120\t\n   121\tdef test_manip_desplazo_cuando_debia_girar_es_BL_M3(pack) -> None:\n   122\t    \"\"\"Mover el intercepto que no cambia es exactamente BL-M3.\"\"\"\n   123\t    v = grade(q(pack, \"q_cs_p_manip\"), {\"p1\": 3, \"p2\": 1, \"m\": 75}, pack.ejemplo)\n   124\t    assert not v.correcta and v.misconception_id == \"BL-M3\"\n   125\t\n   126\t\n   127\tdef test_abierta_no_pasa_por_grader_determinista(pack) -> None:\n   128\t    with pytest.raises(ValueError, match=\"no es determinista\"):\n   129\t        grade(q(pack, \"q_slope_open\"), \"lo que sea\", pack.ejemplo)\ncontent/packs/budget-line/pack.yaml:49:    # HUECO CONOCIDO: es la única sub-skill sin misconception asociada en\ncontent/packs/budget-line/pack.yaml:50:    # misconceptions.yaml. O falta una entrada del catálogo, o esta sub-skill no es\ncontent/packs/budget-line/pack.yaml:62:    misconceptions: [BL-M6, BL-M3]\ncontent/packs/budget-line/pack.yaml:70:    misconceptions: [BL-M1, BL-M5, BL-M2]\ncontent/packs/budget-line/pack.yaml:78:    misconceptions: [BL-M4, BL-M7]\ncontent/packs/budget-line/pack.yaml:86:    misconceptions: [BL-M2]\ncontent/packs/budget-line/pack.yaml:94:    misconceptions: [BL-M3]\ncontent/packs/budget-line/pack.yaml:99:  aciertos_consecutivos: 3\ncontent/packs/budget-line/pack.yaml:103:  max_evidencias_del_juez_llm: 1   # las otras 2 vienen de graders deterministas\ncontent/packs/budget-line/pack.yaml:104:  sin_misconception_activa: true\ncontent/packs/budget-line/questions.yaml:61:      - {es: \"m/p1\", en: \"m/p1\", misconception: BL-M6}\ncontent/packs/budget-line/questions.yaml:62:      - {es: \"-p1/p2\", en: \"-p1/p2\", misconception: BL-M1}\ncontent/packs/budget-line/questions.yaml:63:      - {es: \"m\", en: \"m\", misconception: null}\ncontent/packs/budget-line/questions.yaml:66:  - id: q_slope_numeric\ncontent/packs/budget-line/questions.yaml:92:      - {es: \"-p2/p1\", en: \"-p2/p1\", misconception: BL-M1}\ncontent/packs/budget-line/questions.yaml:93:      - {es: \"+p1/p2, porque ambos precios son positivos\", en: \"+p1/p2, because both prices are positive\", misconception: BL-M5}\ncontent/packs/budget-line/questions.yaml:94:      - {es: \"m/p2\", en: \"m/p2\", misconception: BL-M6}\ncontent/packs/budget-line/questions.yaml:116:    misconceptions_vigilar: [BL-M1, BL-M5]\ncontent/packs/budget-line/questions.yaml:130:      - {es: \"No, porque no agota el ingreso\", en: \"No, because it does not exhaust the income\", misconception: BL-M4}\ncontent/packs/budget-line/questions.yaml:131:      - {es: \"No, porque no está sobre la recta\", en: \"No, because it is not on the line\", misconception: BL-M4}\ncontent/packs/budget-line/questions.yaml:132:      - {es: \"Sí, y además es la mejor canasta posible\", en: \"Yes, and it is also the best possible bundle\", misconception: BL-M7}\ncontent/packs/budget-line/questions.yaml:134:  - id: q_feas_manip\ncontent/packs/budget-line/questions.yaml:143:    verificacion:\ncontent/packs/budget-line/questions.yaml:166:    misconceptions_vigilar: [BL-M4]\ncontent/packs/budget-line/questions.yaml:181:      - {es: \"Se vuelve más plana\", en: \"It becomes flatter\", misconception: BL-M2}\ncontent/packs/budget-line/questions.yaml:182:      - {es: \"Pivota sobre el intercepto de x2\", en: \"It pivots around the x2 intercept\", misconception: BL-M2}\ncontent/packs/budget-line/questions.yaml:183:      - {es: \"No cambia, porque los precios son los mismos\", en: \"It does not change, since prices are the same\", misconception: null}\ncontent/packs/budget-line/questions.yaml:185:  - id: q_cs_m_manip\ncontent/packs/budget-line/questions.yaml:194:    verificacion:\ncontent/packs/budget-line/questions.yaml:215:      - {es: \"Se desplaza hacia adentro, paralela\", en: \"It shifts inward, parallel\", misconception: BL-M3}\ncontent/packs/budget-line/questions.yaml:216:      - {es: \"Baja el intercepto vertical m/p2\", en: \"The vertical intercept m/p2 falls\", misconception: BL-M3}\ncontent/packs/budget-line/questions.yaml:217:      - {es: \"Se vuelve más plana\", en: \"It becomes flatter\", misconception: BL-M1}\ncontent/packs/budget-line/questions.yaml:219:  - id: q_cs_p_manip\ncontent/packs/budget-line/questions.yaml:228:    verificacion:\ncontent/packs/budget-line/questions.yaml:256:    misconceptions_vigilar: [BL-M3, BL-M2]\ncontent/packs/budget-line/questions.yaml:260:  # `revisar_en_validacion` en pack.yaml por no tener misconception asociada.\ncontent/packs/budget-line/questions.yaml:270:      es: \"¿Cuál de estas expresiones es la línea presupuestaria?\"\ncontent/packs/budget-line/questions.yaml:274:      - {es: \"p1·x1 + p2·x2 ≤ m\", en: \"p1·x1 + p2·x2 ≤ m\", misconception: BL-M4}\ncontent/packs/budget-line/questions.yaml:275:      - {es: \"x1/p1 + x2/p2 = m\", en: \"x1/p1 + x2/p2 = m\", misconception: null}\ncontent/packs/budget-line/questions.yaml:276:      - {es: \"p1·p2 = m\", en: \"p1·p2 = m\", misconception: null}\napp/server/core/judge/deterministic.py:8:`grader_manip.py` por separado: van juntos porque comparten el evaluador de expresiones\napp/server/core/judge/deterministic.py:31:    Con `ast` y una lista blanca de operadores en vez de `eval`: estas expresiones\napp/server/core/judge/deterministic.py:57:    misconception_id: str | None = None\napp/server/core/judge/deterministic.py:90:            return Veredicto(False, 0.0, misconception_id=mid, esperado=esperado,\napp/server/core/judge/deterministic.py:106:    return Veredicto(False, 0.0, misconception_id=elegida.misconception, esperado=correcto)\napp/server/core/judge/deterministic.py:117:    v = q.verificacion or {}\napp/server/core/judge/deterministic.py:128:            return Veredicto(False, 0.0, misconception_id=diag.get(\"sobre_la_recta\"),\napp/server/core/judge/deterministic.py:151:        return Veredicto(False, 0.0, misconception_id=diag.get(\"pendiente_cambio\"),\napp/server/core/judge/deterministic.py:154:        return Veredicto(False, 0.0, misconception_id=diag.get(\"intercepto_x2_cambio\"),\napp/server/core/judge/deterministic.py:156:    return Veredicto(False, 0.0, misconception_id=diag.get(\"desplazamiento_paralelo\"),\ncontent/packs/budget-line/misconceptions.yaml:1:# Catálogo curado de misconceptions — línea presupuestaria\ncontent/packs/budget-line/misconceptions.yaml:8:# publicado de economía asigna ids estables a las misconceptions (hallazgo de T-002), así\ncontent/packs/budget-line/misconceptions.yaml:22:misconceptions:\napp/server/core/content/schema.py:52:    misconceptions: list[str] = Field(default_factory=list)\napp/server/core/content/schema.py:66:    aciertos_consecutivos: int = 3\napp/server/core/content/schema.py:69:    max_evidencias_del_juez_llm: int = 1\napp/server/core/content/schema.py:70:    sin_misconception_activa: bool = True\napp/server/core/content/schema.py:74:        if self.max_evidencias_del_juez_llm > self.aciertos_consecutivos:\napp/server/core/content/schema.py:76:                \"max_evidencias_del_juez_llm no puede superar aciertos_consecutivos\"\napp/server/core/content/schema.py:78:        if self.sin_andamiaje_min > self.aciertos_consecutivos:\napp/server/core/content/schema.py:80:                \"sin_andamiaje_min no puede superar aciertos_consecutivos\"\napp/server/core/content/schema.py:101:    misconception: str | None = None\napp/server/core/content/schema.py:116:    verificacion: dict | None = None\napp/server/core/content/schema.py:118:    misconceptions_vigilar: list[str] = Field(default_factory=list)\napp/server/core/content/schema.py:131:        if self.modalidad == \"manip\" and not self.verificacion:\napp/server/core/content/schema.py:132:            raise ValueError(f\"{self.id}: manip sin verificacion\")\napp/server/core/content/schema.py:171:    misconceptions: list[Misconception] = Field(default_factory=list)\napp/server/core/content/schema.py:178:        misc_ids = {m.id for m in self.misconceptions}\napp/server/core/content/schema.py:183:            for mid in s.misconceptions:\napp/server/core/content/schema.py:185:                    errs.append(f\"sub-skill {s.id} apunta al misconception inexistente {mid}\")\napp/server/core/content/schema.py:186:        for m in self.misconceptions:\napp/server/core/content/schema.py:189:                    errs.append(f\"misconception {m.id} apunta a la sub-skill inexistente {sid}\")\napp/server/core/content/schema.py:193:            citados = set(q.misconceptions_vigilar)\napp/server/core/content/schema.py:195:            citados |= {o.misconception for o in (q.opciones or []) if o.misconception}\napp/server/core/content/schema.py:198:                    errs.append(f\"pregunta {q.id} cita el misconception inexistente {mid}\")\napp/server/core/content/schema.py:215:            necesarias = self.dominio.aciertos_consecutivos - self.dominio.max_evidencias_del_juez_llm\napp/server/core/content/schema.py:220:                    f\"{self.dominio.max_evidencias_del_juez_llm}\"\napp/server/core/content/schema.py:230:    def misconception(self, mid: str) -> Misconception:\napp/server/core/content/schema.py:231:        return next(m for m in self.misconceptions if m.id == mid)\napp/server/core/content/schema.py:234:    def enum_misconceptions(self) -> list[str]:\napp/server/core/content/schema.py:241:        return [m.id for m in self.misconceptions] + [\"NINGUNA\", \"FUERA_DE_CATALOGO\"]\napp/server/core/content/loader.py:52:        misc_file = d / \"misconceptions.yaml\"\napp/server/core/content/loader.py:53:        data[\"misconceptions\"] = _yaml(misc_file).get(\"misconceptions\", []) if misc_file.exists() else []\n","exit_code":0,"status":"completed"}}
