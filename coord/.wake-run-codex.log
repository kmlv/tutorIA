{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba content/packs/budget-line/questions.yaml | sed -n '45,250p'\nrg -n \\\"Pack|integridad|dominio|modalidades_min|determinista|sub-skill\\\" tests -g '*.py'\nnl -ba tests/test_content_pack.py | sed -n '1,360p' 2>/dev/null || true\nrg -n \\\"grade\\\\(|grade_numeric|grade_manip|eval_expr\\\" app/server tests -g '*.py'\"","aggregated_output":"    45\t      en: \"And if you spend everything on coffee? Round to one decimal.\"\n    46\t    respuesta: {expr: \"m / p1\", tolerancia: 0.05}\n    47\t    diagnostico_si_falla:\n    48\t      \"m / p2\": BL-M6\n    49\t\n    50\t  - id: q_int_mcq\n    51\t    subskill_primary: BL.INT\n    52\t    tier: 2\n    53\t    modalidad: mcq\n    54\t    grader: deterministic\n    55\t    andamiaje: false\n    56\t    enunciado:\n    57\t      es: \"¿Cuál es el intercepto vertical de la línea presupuestaria?\"\n    58\t      en: \"What is the vertical intercept of the budget line?\"\n    59\t    opciones:\n    60\t      - {es: \"m/p2\", en: \"m/p2\", correcta: true}\n    61\t      - {es: \"m/p1\", en: \"m/p1\", misconception: BL-M6}\n    62\t      - {es: \"-p1/p2\", en: \"-p1/p2\", misconception: BL-M1}\n    63\t      - {es: \"m\", en: \"m\", misconception: null}\n    64\t\n    65\t  # ---------------------------------------------------------------- BL.SLOPE\n    66\t  - id: q_slope_numeric\n    67\t    subskill_primary: BL.SLOPE\n    68\t    tier: 1\n    69\t    modalidad: numeric\n    70\t    grader: deterministic\n    71\t    andamiaje: false\n    72\t    enunciado:\n    73\t      es: \"¿Cuál es la pendiente de la línea presupuestaria? Incluye el signo.\"\n    74\t      en: \"What is the slope of the budget line? Include the sign.\"\n    75\t    respuesta: {expr: \"-p1 / p2\", tolerancia: 0.01}\n    76\t    diagnostico_si_falla:\n    77\t      \"-p2 / p1\": BL-M1\n    78\t      \"p1 / p2\": BL-M5\n    79\t      \"m / p2\": BL-M1     # confunde pendiente con intercepto\n    80\t\n    81\t  - id: q_slope_mcq\n    82\t    subskill_primary: BL.SLOPE\n    83\t    tier: 2\n    84\t    modalidad: mcq\n    85\t    grader: deterministic\n    86\t    andamiaje: false\n    87\t    enunciado:\n    88\t      es: \"La pendiente de la línea presupuestaria es:\"\n    89\t      en: \"The slope of the budget line is:\"\n    90\t    opciones:\n    91\t      - {es: \"-p1/p2\", en: \"-p1/p2\", correcta: true}\n    92\t      - {es: \"-p2/p1\", en: \"-p2/p1\", misconception: BL-M1}\n    93\t      - {es: \"+p1/p2, porque ambos precios son positivos\", en: \"+p1/p2, because both prices are positive\", misconception: BL-M5}\n    94\t      - {es: \"m/p2\", en: \"m/p2\", misconception: BL-M6}\n    95\t\n    96\t  - id: q_slope_open\n    97\t    subskill_primary: BL.SLOPE\n    98\t    subskills_secundarias: [BL.CS.P]\n    99\t    tier: 3\n   100\t    modalidad: open\n   101\t    grader: llm\n   102\t    andamiaje: false\n   103\t    enunciado:\n   104\t      es: \"Explica con tus palabras qué significa que la pendiente sea {{slope}}. No uses la fórmula: dímelo en café y jugo.\"\n   105\t      en: \"Explain in your own words what a slope of {{slope}} means. Don't use the formula: tell me in coffee and juice.\"\n   106\t    key_points:\n   107\t      - id: kp_tradeoff\n   108\t        es: identifica que hay que renunciar a {{slope_abs}} cafés por un kilo más de café\n   109\t        en: identifies giving up {{slope_abs}} coffees for one more kilo of coffee\n   110\t      - id: kp_sign\n   111\t        es: el signo negativo refleja que un bien sube y el otro baja\n   112\t        en: the negative sign reflects one good rising as the other falls\n   113\t      - id: kp_relative_price\n   114\t        es: lo conecta con el precio relativo o el costo de oportunidad\n   115\t        en: connects it to relative price or opportunity cost\n   116\t    misconceptions_vigilar: [BL-M1, BL-M5]\n   117\t\n   118\t  # ---------------------------------------------------------------- BL.FEAS\n   119\t  - id: q_feas_mcq\n   120\t    subskill_primary: BL.FEAS\n   121\t    tier: 1\n   122\t    modalidad: mcq\n   123\t    grader: deterministic\n   124\t    andamiaje: false\n   125\t    enunciado:\n   126\t      es: \"Compras 10 kg de café y 20 L de jugo. ¿Esa canasta es alcanzable?\"\n   127\t      en: \"You buy 10 kg of coffee and 20 L of juice. Is that bundle affordable?\"\n   128\t    opciones:\n   129\t      - {es: \"Sí, gasta 50 y te sobran 50\", en: \"Yes, it costs 50 and leaves 50 over\", correcta: true}\n   130\t      - {es: \"No, porque no agota el ingreso\", en: \"No, because it does not exhaust the income\", misconception: BL-M4}\n   131\t      - {es: \"No, porque no está sobre la recta\", en: \"No, because it is not on the line\", misconception: BL-M4}\n   132\t      - {es: \"Sí, y además es la mejor canasta posible\", en: \"Yes, and it is also the best possible bundle\", misconception: BL-M7}\n   133\t\n   134\t  - id: q_feas_manip\n   135\t    subskill_primary: BL.FEAS\n   136\t    tier: 2\n   137\t    modalidad: manip\n   138\t    grader: deterministic\n   139\t    andamiaje: false\n   140\t    enunciado:\n   141\t      es: \"Arrastra el punto hasta una canasta que puedas pagar SIN gastar todo tu ingreso.\"\n   142\t      en: \"Drag the point to a bundle you can afford WITHOUT spending your whole income.\"\n   143\t    verificacion:\n   144\t      tipo: region\n   145\t      condicion: \"p1*x1 + p2*x2 < m\"\n   146\t      margen: 2.0\n   147\t    diagnostico_si_falla:\n   148\t      sobre_la_recta: BL-M4\n   149\t\n   150\t  - id: q_feas_open\n   151\t    subskill_primary: BL.FEAS\n   152\t    tier: 3\n   153\t    modalidad: open\n   154\t    grader: llm\n   155\t    andamiaje: false\n   156\t    enunciado:\n   157\t      es: \"¿Qué diferencia hay entre la línea presupuestaria y el conjunto presupuestario?\"\n   158\t      en: \"What is the difference between the budget line and the budget set?\"\n   159\t    key_points:\n   160\t      - id: kp_boundary\n   161\t        es: la línea es la frontera del conjunto, no el conjunto entero\n   162\t        en: the line is the boundary of the set, not the whole set\n   163\t      - id: kp_interior\n   164\t        es: el conjunto incluye canastas que no agotan el ingreso\n   165\t        en: the set includes bundles that do not exhaust income\n   166\t    misconceptions_vigilar: [BL-M4]\n   167\t\n   168\t  # ---------------------------------------------------------------- BL.CS.M\n   169\t  - id: q_cp1_income_direction\n   170\t    subskill_primary: BL.CS.M\n   171\t    tier: 1\n   172\t    modalidad: mcq\n   173\t    grader: deterministic\n   174\t    andamiaje: false\n   175\t    checkpoint: cp1\n   176\t    enunciado:\n   177\t      es: \"Tu ingreso sube de {{m}} a 150. ¿Qué le pasa a la línea?\"\n   178\t      en: \"Your income rises from {{m}} to 150. What happens to the line?\"\n   179\t    opciones:\n   180\t      - {es: \"Se desplaza hacia afuera, paralela\", en: \"It shifts outward, parallel\", correcta: true}\n   181\t      - {es: \"Se vuelve más plana\", en: \"It becomes flatter\", misconception: BL-M2}\n   182\t      - {es: \"Pivota sobre el intercepto de x2\", en: \"It pivots around the x2 intercept\", misconception: BL-M2}\n   183\t      - {es: \"No cambia, porque los precios son los mismos\", en: \"It does not change, since prices are the same\", misconception: null}\n   184\t\n   185\t  - id: q_cs_m_manip\n   186\t    subskill_primary: BL.CS.M\n   187\t    tier: 2\n   188\t    modalidad: manip\n   189\t    grader: deterministic\n   190\t    andamiaje: false\n   191\t    enunciado:\n   192\t      es: \"El ingreso sube a 150. Mueve la recta a su nueva posición.\"\n   193\t      en: \"Income rises to 150. Move the line to its new position.\"\n   194\t    verificacion:\n   195\t      tipo: recta\n   196\t      pendiente_esperada: \"-p1/p2\"\n   197\t      tolerancia_pendiente: 0.10\n   198\t      intercepto_x2_esperado: 150.0\n   199\t      tolerancia_intercepto: 5.0\n   200\t    diagnostico_si_falla:\n   201\t      pendiente_cambio: BL-M2\n   202\t\n   203\t  # ---------------------------------------------------------------- BL.CS.P\n   204\t  - id: q_cs_p_mcq\n   205\t    subskill_primary: BL.CS.P\n   206\t    tier: 2\n   207\t    modalidad: mcq\n   208\t    grader: deterministic\n   209\t    andamiaje: false\n   210\t    enunciado:\n   211\t      es: \"El precio del café sube de {{p1}} a 4. ¿Qué le pasa a la línea?\"\n   212\t      en: \"The price of coffee rises from {{p1}} to 4. What happens to the line?\"\n   213\t    opciones:\n   214\t      - {es: \"Pivota: el intercepto del jugo no se mueve y la recta se empina\", en: \"It pivots: the juice intercept stays and the line gets steeper\", correcta: true}\n   215\t      - {es: \"Se desplaza hacia adentro, paralela\", en: \"It shifts inward, parallel\", misconception: BL-M3}\n   216\t      - {es: \"Baja el intercepto vertical m/p2\", en: \"The vertical intercept m/p2 falls\", misconception: BL-M3}\n   217\t      - {es: \"Se vuelve más plana\", en: \"It becomes flatter\", misconception: BL-M1}\n   218\t\n   219\t  - id: q_cs_p_manip\n   220\t    subskill_primary: BL.CS.P\n   221\t    tier: 3\n   222\t    modalidad: manip\n   223\t    grader: deterministic\n   224\t    andamiaje: false\n   225\t    enunciado:\n   226\t      es: \"El precio del café sube a 4. Mueve la recta.\"\n   227\t      en: \"The price of coffee rises to 4. Move the line.\"\n   228\t    verificacion:\n   229\t      tipo: recta\n   230\t      pendiente_esperada: -4.0\n   231\t      tolerancia_pendiente: 0.10\n   232\t      intercepto_x2_esperado: \"m / p2\"\n   233\t      tolerancia_intercepto: 3.0\n   234\t    diagnostico_si_falla:\n   235\t      intercepto_x2_cambio: BL-M3\n   236\t      desplazamiento_paralelo: BL-M3\n   237\t\n   238\t  - id: q_cp2_why_intercept_fixed\n   239\t    subskill_primary: BL.CS.P\n   240\t    subskills_secundarias: [BL.INT]\n   241\t    tier: 3\n   242\t    modalidad: open\n   243\t    grader: llm\n   244\t    andamiaje: false\n   245\t    checkpoint: cp2\n   246\t    enunciado:\n   247\t      es: \"¿Por qué el intercepto del jugo NO se mueve cuando sube el precio del café?\"\n   248\t      en: \"Why does the juice intercept NOT move when the price of coffee rises?\"\n   249\t    key_points:\n   250\t      - id: kp_intercept_formula\ntests/test_m0.py:7:from app.server.core.content.loader import FilesystemPackSource\ntests/test_m0.py:8:from app.server.core.content.schema import Dominio, Pack\ntests/test_m0.py:13:def pack() -> Pack:\ntests/test_m0.py:14:    return FilesystemPackSource().get_pack(\"budget-line\")\ntests/test_m0.py:19:def test_pack_carga_y_es_coherente(pack: Pack) -> None:\ntests/test_m0.py:26:def test_ejemplo_da_la_pendiente_del_guion(pack: Pack) -> None:\ntests/test_m0.py:32:def test_el_enum_del_juez_lleva_los_escapes(pack: Pack) -> None:\ntests/test_m0.py:39:def test_los_timelines_estan_alineados(pack: Pack) -> None:\ntests/test_m0.py:53:def test_cada_subskill_esencial_puede_alcanzar_dominio(pack: Pack) -> None:\ntests/test_m0.py:55:    evidencias, al menos 2 ítems deterministas por sub-skill.\"\"\"\ntests/test_m0.py:56:    necesarias = pack.dominio.aciertos_consecutivos - pack.dominio.max_evidencias_del_juez_llm\ntests/test_m0.py:61:        assert len({q.modalidad for q in mias}) >= pack.dominio.modalidades_min, s.id\ntests/test_m0.py:63:        assert len(det) >= necesarias, f\"{s.id}: {len(det)} deterministas, faltan {necesarias}\"\ntests/test_m0.py:66:def test_todas_las_misconceptions_son_detectables_sin_llm(pack: Pack) -> None:\ntests/test_m0.py:68:    diagnóstico se apoya solo en ítems deterministas.\"\"\"\ntests/test_m0.py:79:def test_dominio_incoherente_es_rechazado() -> None:\ntests/test_graders.py:1:\"\"\"Los graders deterministas no solo corrigen: diagnostican.\ntests/test_graders.py:10:from app.server.core.content.loader import FilesystemPackSource\ntests/test_graders.py:16:    return FilesystemPackSource().get_pack(\"budget-line\")\ntests/test_graders.py:127:def test_abierta_no_pasa_por_grader_determinista(pack) -> None:\ntests/test_graders.py:128:    with pytest.raises(ValueError, match=\"no es determinista\"):\nnl: tests/test_content_pack.py: No such file or directory\ntests/test_graders.py:11:from app.server.core.judge.deterministic import eval_expr, grade\ntests/test_graders.py:25:def test_eval_expr_resuelve_las_del_banco() -> None:\ntests/test_graders.py:27:    assert eval_expr(\"m / p2\", p) == 100\ntests/test_graders.py:28:    assert eval_expr(\"-p1 / p2\", p) == -3\ntests/test_graders.py:29:    assert eval_expr(\"(m - p1*12) / p2\", p) == 64\ntests/test_graders.py:32:def test_eval_expr_rechaza_codigo_arbitrario() -> None:\ntests/test_graders.py:37:            eval_expr(malo, {\"m\": 1.0})\ntests/test_graders.py:43:    v = grade(q(pack, \"q_int_numeric_1\"), \"100\", pack.ejemplo)\ntests/test_graders.py:49:    v = grade(q(pack, \"q_int_numeric_2\"), \"33,3\", pack.ejemplo)\ntests/test_graders.py:55:    v = grade(q(pack, \"q_int_numeric_1\"), \"33.33\", pack.ejemplo)\ntests/test_graders.py:60:    v = grade(q(pack, \"q_slope_numeric\"), \"-0.333\", pack.ejemplo)\ntests/test_graders.py:65:    v = grade(q(pack, \"q_slope_numeric\"), \"3\", pack.ejemplo)\ntests/test_graders.py:70:    v = grade(q(pack, \"q_slope_numeric\"), \"no sé\", pack.ejemplo)\ntests/test_graders.py:79:    assert grade(qq, correcto, pack.ejemplo).correcta\ntests/test_graders.py:82:    v = grade(qq, invertida, pack.ejemplo)\ntests/test_graders.py:87:    assert not grade(q(pack, \"q_slope_mcq\"), 99, pack.ejemplo).correcta\ntests/test_graders.py:93:    v = grade(q(pack, \"q_feas_manip\"), {\"x1\": 10, \"x2\": 20}, pack.ejemplo)\ntests/test_graders.py:100:    v = grade(q(pack, \"q_feas_manip\"), {\"x1\": 20, \"x2\": 40}, pack.ejemplo)\ntests/test_graders.py:105:    v = grade(q(pack, \"q_cs_m_manip\"), {\"p1\": 3, \"p2\": 1, \"m\": 150}, pack.ejemplo)\ntests/test_graders.py:111:    v = grade(q(pack, \"q_cs_m_manip\"), {\"p1\": 1.5, \"p2\": 1, \"m\": 150}, pack.ejemplo)\ntests/test_graders.py:117:    v = grade(q(pack, \"q_cs_p_manip\"), {\"p1\": 4, \"p2\": 1, \"m\": 100}, pack.ejemplo)\ntests/test_graders.py:123:    v = grade(q(pack, \"q_cs_p_manip\"), {\"p1\": 3, \"p2\": 1, \"m\": 75}, pack.ejemplo)\ntests/test_graders.py:129:        grade(q(pack, \"q_slope_open\"), \"lo que sea\", pack.ejemplo)\napp/server/core/judge/deterministic.py:28:def eval_expr(expr: str, params: dict[str, float]) -> float:\napp/server/core/judge/deterministic.py:68:def grade_numeric(q: Question, raw: str, e: Ejemplo) -> Veredicto:\napp/server/core/judge/deterministic.py:75:    esperado = eval_expr(spec[\"expr\"], _params(e))\napp/server/core/judge/deterministic.py:86:            alt = eval_expr(expr, _params(e))\napp/server/core/judge/deterministic.py:111:def grade_manip(q: Question, dado: dict, e: Ejemplo) -> Veredicto:\napp/server/core/judge/deterministic.py:161:    return eval_expr(v, params) if isinstance(v, str) else float(v)\napp/server/core/judge/deterministic.py:166:def grade(q: Question, valor: Any, e: Ejemplo) -> Veredicto:\napp/server/core/judge/deterministic.py:168:        return grade_numeric(q, valor, e)\napp/server/core/judge/deterministic.py:172:        return grade_manip(q, valor, e)\napp/server/main.py:88:    v = grade(q, body.valor, pack.ejemplo)\n","exit_code":0,"status":"completed"}}
