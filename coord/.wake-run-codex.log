{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba app/server/main.py | sed -n '1,150p'\nnl -ba app/server/core/content/loader.py | sed -n '1,180p'\nnl -ba tests/test_m0.py | sed -n '1,150p'\nrg -n \\\"class .*Answer|valor:|BaseModel\\\" app/server -g '*.py'\nfind app/server -maxdepth 4 -type f -name '*.py' -print\"","aggregated_output":"     1\t\"\"\"Servidor del PoC.\n     2\t\n     3\tLa API key del proveedor LLM vive AQUÍ y nunca llega al navegador (decisión 20).\n     4\tEn M0 todavía no hay proveedor: esto es el esqueleto y los endpoints de contenido.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport os\n     9\t\n    10\tfrom fastapi import FastAPI, HTTPException\n    11\tfrom fastapi.responses import FileResponse\n    12\tfrom pydantic import BaseModel\n    13\t\n    14\tfrom app.server.core.content.loader import FilesystemPackSource\n    15\tfrom app.server.core.judge.deterministic import grade\n    16\tfrom app.server.db.repo import Repo\n    17\t\n    18\tapp = FastAPI(title=\"tutorIA\", version=\"0.1.0\")\n    19\t\n    20\tpacks = FilesystemPackSource()\n    21\trepo = Repo(os.environ.get(\"TUTORIA_DB\") or None)\n    22\t\n    23\t\n    24\t@app.get(\"/api/health\")\n    25\tdef health() -> dict:\n    26\t    return {\"ok\": True, \"packs\": packs.available()}\n    27\t\n    28\t\n    29\t@app.get(\"/api/packs/{concept_id}\")\n    30\tdef get_pack(concept_id: str, lang: str = \"es\") -> dict:\n    31\t    try:\n    32\t        pack = packs.get_pack(concept_id, lang)\n    33\t    except FileNotFoundError as e:\n    34\t        raise HTTPException(status_code=404, detail=str(e)) from e\n    35\t    return pack.model_dump(mode=\"json\")\n    36\t\n    37\t\n    38\tclass NewSession(BaseModel):\n    39\t    concept_id: str\n    40\t    lang: str = \"es\"\n    41\t    media_variant: str = \"A\"\n    42\t\n    43\t\n    44\t@app.post(\"/api/session\")\n    45\tdef create_session(body: NewSession) -> dict:\n    46\t    try:\n    47\t        pack = packs.get_pack(body.concept_id, body.lang)\n    48\t    except FileNotFoundError as e:\n    49\t        raise HTTPException(status_code=404, detail=str(e)) from e\n    50\t    if body.lang not in pack.lang:\n    51\t        raise HTTPException(status_code=400, detail=f\"el pack no tiene idioma {body.lang}\")\n    52\t\n    53\t    sid = repo.create_session(\n    54\t        concept_id=pack.id, pack_version=pack.version,\n    55\t        lang=body.lang, media_variant=body.media_variant,\n    56\t    )\n    57\t    tl = pack.timelines.get(body.lang)\n    58\t    return {\n    59\t        \"session_id\": sid,\n    60\t        \"concept_id\": pack.id,\n    61\t        \"titulo\": getattr(pack.titulo, body.lang),\n    62\t        \"media\": tl.model_dump(mode=\"json\") if tl else None,\n    63\t        \"checkpoints\": [c.model_dump() for c in pack.checkpoints],\n    64\t    }\n    65\t\n    66\t\n    67\tclass AnswerIn(BaseModel):\n    68\t    question_id: str\n    69\t    valor: object\n    70\t    con_andamiaje: bool = False\n    71\t\n    72\t\n    73\t@app.post(\"/api/session/{session_id}/answer\")\n    74\tdef post_answer(session_id: str, body: AnswerIn) -> dict:\n    75\t    \"\"\"Corrige y registra. El veredicto se decide AQUÍ: si el navegador conociera la\n    76\t    respuesta, el estudiante podría leerla en el bundle.\"\"\"\n    77\t    row = repo.get_session(session_id)\n    78\t    if row is None:\n    79\t        raise HTTPException(status_code=404, detail=\"sesión desconocida\")\n    80\t    pack = packs.get_pack(row[\"concept_id\"], row[\"lang\"])\n    81\t\n    82\t    q = next((x for x in pack.questions if x.id == body.question_id), None)\n    83\t    if q is None:\n    84\t        raise HTTPException(status_code=404, detail=f\"pregunta {body.question_id} no existe\")\n    85\t    if q.grader != \"deterministic\":\n    86\t        raise HTTPException(status_code=501, detail=\"el juez LLM llega en M3\")\n    87\t\n    88\t    v = grade(q, body.valor, pack.ejemplo)\n    89\t    repo.record_answer(\n    90\t        session_id=session_id, question_id=q.id, modalidad=q.modalidad,\n    91\t        raw_answer=body.valor, grader=\"deterministic\", score=v.score,\n    92\t        misconception_id=v.misconception_id, con_andamiaje=body.con_andamiaje,\n    93\t    )\n    94\t    repo.append_event(session_id, \"answer.judged\", {\n    95\t        \"question_id\": q.id, \"correcta\": v.correcta,\n    96\t        \"misconception_id\": v.misconception_id,\n    97\t    })\n    98\t\n    99\t    out: dict = {\"correcta\": v.correcta, \"score\": v.score}\n   100\t    if v.misconception_id:\n   101\t        m = pack.misconception(v.misconception_id)\n   102\t        # el estudiante NO ve el id: ve la sonda socrática ya escrita en el catálogo.\n   103\t        # El id crudo es para el instructor (decisión 6).\n   104\t        out[\"socratica\"] = getattr(m.socratic_probe, row[\"lang\"])\n   105\t    return out\n   106\t\n   107\t\n   108\tclass EventIn(BaseModel):\n   109\t    type: str\n   110\t    payload: dict = {}\n   111\t\n   112\t\n   113\t@app.post(\"/api/session/{session_id}/events\")\n   114\tdef post_event(session_id: str, body: EventIn) -> dict:\n   115\t    \"\"\"Telemetría append-only. Incluye el desfase interno de cada cue (que sustituye a\n   116\t    la medición externa con celular) y la latencia hasta la primera acción tras un\n   117\t    checkpoint, que es la señal de atención que justifica la pausa automática.\"\"\"\n   118\t    if repo.get_session(session_id) is None:\n   119\t        raise HTTPException(status_code=404, detail=\"sesión desconocida\")\n   120\t    seq = repo.append_event(session_id, body.type, body.payload)\n   121\t    return {\"seq\": seq}\n   122\t\n   123\t\n   124\t@app.get(\"/media/{concept_id}/{filename}\")\n   125\tdef media(concept_id: str, filename: str) -> FileResponse:\n   126\t    \"\"\"Sirve el audio compilado. Se valida el nombre para que no se pueda salir del\n   127\t    directorio del pack.\"\"\"\n   128\t    if \"/\" in filename or \"..\" in filename or \"/\" in concept_id or \"..\" in concept_id:\n   129\t        raise HTTPException(status_code=400, detail=\"ruta inválida\")\n   130\t    path = (packs.root / concept_id / \"media\" / filename).resolve()\n   131\t    base = (packs.root / concept_id / \"media\").resolve()\n   132\t    if not str(path).startswith(str(base)) or not path.is_file():\n   133\t        raise HTTPException(status_code=404, detail=\"no encontrado\")\n   134\t    return FileResponse(path)\n   135\t\n   136\t\n   137\t@app.get(\"/api/session/{session_id}\")\n   138\tdef read_session(session_id: str) -> dict:\n   139\t    row = repo.get_session(session_id)\n   140\t    if row is None:\n   141\t        raise HTTPException(status_code=404, detail=\"sesión desconocida\")\n   142\t    return {\n   143\t        \"session_id\": row[\"id\"],\n   144\t        \"concept_id\": row[\"concept_id\"],\n   145\t        \"lang\": row[\"lang\"],\n   146\t        \"phase\": row[\"phase\"],\n   147\t        \"media_variant\": row[\"media_variant\"],\n   148\t        \"events\": len(repo.events(session_id)),\n   149\t    }\n     1\t\"\"\"Carga de content packs.\n     2\t\n     3\t`PackSource` es el punto de extensión del PLAN §2.2. Hoy solo existe\n     4\t`FilesystemPackSource`; el día que haya generación al vuelo se añade\n     5\t`GeneratedPackSource` con la misma firma y **el runtime no cambia**.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport pathlib\n    10\tfrom typing import Protocol\n    11\t\n    12\timport yaml\n    13\t\n    14\tfrom .schema import Pack, Timeline\n    15\t\n    16\tREPO_ROOT = pathlib.Path(__file__).resolve().parents[4]\n    17\tPACKS_DIR = REPO_ROOT / \"content\" / \"packs\"\n    18\t\n    19\t\n    20\tclass StudentProfile(Protocol):\n    21\t    \"\"\"Lo que la generación futura necesitará para personalizar. Hoy nadie lo usa.\"\"\"\n    22\t\n    23\t    id: str\n    24\t    lang: str\n    25\t\n    26\t\n    27\tclass PackSource(Protocol):\n    28\t    def get_pack(self, concept_id: str, lang: str,\n    29\t                 student: StudentProfile | None = None) -> Pack: ...\n    30\t\n    31\t\n    32\tclass FilesystemPackSource:\n    33\t    \"\"\"Lee `content/packs/<id>/`. Es la fuente de HOY.\"\"\"\n    34\t\n    35\t    def __init__(self, root: pathlib.Path | None = None) -> None:\n    36\t        self.root = root or PACKS_DIR\n    37\t\n    38\t    def available(self) -> list[str]:\n    39\t        if not self.root.is_dir():\n    40\t            return []\n    41\t        return sorted(p.name for p in self.root.iterdir()\n    42\t                      if (p / \"pack.yaml\").exists())\n    43\t\n    44\t    def get_pack(self, concept_id: str, lang: str = \"es\",\n    45\t                 student: StudentProfile | None = None) -> Pack:\n    46\t        d = self.root / concept_id\n    47\t        if not (d / \"pack.yaml\").exists():\n    48\t            raise FileNotFoundError(f\"no existe el pack {concept_id} en {self.root}\")\n    49\t\n    50\t        data = _yaml(d / \"pack.yaml\")\n    51\t\n    52\t        misc_file = d / \"misconceptions.yaml\"\n    53\t        data[\"misconceptions\"] = _yaml(misc_file).get(\"misconceptions\", []) if misc_file.exists() else []\n    54\t\n    55\t        q_file = d / \"questions.yaml\"\n    56\t        data[\"questions\"] = _yaml(q_file).get(\"questions\", []) if q_file.exists() else []\n    57\t\n    58\t        # las timelines son opcionales: el pack es válido antes de compilar el audio\n    59\t        timelines: dict[str, Timeline] = {}\n    60\t        media = d / \"media\"\n    61\t        if media.is_dir():\n    62\t            for tl in sorted(media.glob(\"timeline.*.json\")):\n    63\t                import json\n    64\t                t = Timeline.model_validate(json.loads(tl.read_text(encoding=\"utf-8\")))\n    65\t                timelines[t.lang] = t\n    66\t        data[\"timelines\"] = timelines\n    67\t\n    68\t        # `salidas` e `iesa_micro` son metadatos de autoría, no los consume el runtime\n    69\t        for k in (\"salidas\", \"iesa_micro\"):\n    70\t            data.pop(k, None)\n    71\t\n    72\t        return Pack.model_validate(data)\n    73\t\n    74\t\n    75\tdef _yaml(path: pathlib.Path) -> dict:\n    76\t    return yaml.safe_load(path.read_text(encoding=\"utf-8\")) or {}\n     1\t\"\"\"Tests de M0: el pack carga y es coherente, la DB funciona, el servidor responde.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport pytest\n     5\tfrom fastapi.testclient import TestClient\n     6\t\n     7\tfrom app.server.core.content.loader import FilesystemPackSource\n     8\tfrom app.server.core.content.schema import Dominio, Pack\n     9\tfrom app.server.db.repo import Repo\n    10\t\n    11\t\n    12\t@pytest.fixture(scope=\"module\")\n    13\tdef pack() -> Pack:\n    14\t    return FilesystemPackSource().get_pack(\"budget-line\")\n    15\t\n    16\t\n    17\t# ---- contenido -------------------------------------------------------------\n    18\t\n    19\tdef test_pack_carga_y_es_coherente(pack: Pack) -> None:\n    20\t    assert pack.id == \"budget-line\"\n    21\t    assert len(pack.sub_skills) == 6\n    22\t    assert len(pack.misconceptions) == 7\n    23\t    assert len(pack.questions) == 16\n    24\t\n    25\t\n    26\tdef test_ejemplo_da_la_pendiente_del_guion(pack: Pack) -> None:\n    27\t    assert pack.ejemplo.pendiente == -3.0\n    28\t    assert pack.ejemplo.intercepto_x2 == 100.0\n    29\t    assert round(pack.ejemplo.intercepto_x1, 2) == 33.33\n    30\t\n    31\t\n    32\tdef test_el_enum_del_juez_lleva_los_escapes(pack: Pack) -> None:\n    33\t    \"\"\"Sin NINGUNA/FUERA_DE_CATALOGO el gate 'cero ids fuera de catálogo' se pasaría\n    34\t    por construcción, porque el juez estaría obligado a inventar un diagnóstico.\"\"\"\n    35\t    assert pack.enum_misconceptions[-2:] == [\"NINGUNA\", \"FUERA_DE_CATALOGO\"]\n    36\t    assert len(pack.enum_misconceptions) == len(pack.misconceptions) + 2\n    37\t\n    38\t\n    39\tdef test_los_timelines_estan_alineados(pack: Pack) -> None:\n    40\t    \"\"\"Sin número mágico: los dos idiomas deben tener LOS MISMOS cues, y todos alineados.\n    41\t    Un conteo fijo solo dice que alguien editó el guion, no que algo esté mal.\"\"\"\n    42\t    assert set(pack.timelines) == {\"es\", \"en\"}\n    43\t    ids = {lang: [c.id for c in tl.cues] for lang, tl in pack.timelines.items()}\n    44\t    assert ids[\"es\"] == ids[\"en\"], \"los guiones divergen en cues entre idiomas\"\n    45\t    for lang, tl in pack.timelines.items():\n    46\t        sin_alinear = [c.id for c in tl.cues if c.t is None]\n    47\t        assert not sin_alinear, f\"{lang}: cues sin alinear {sin_alinear}\"\n    48\t        # los cues deben ir en orden temporal estricto\n    49\t        ts = [c.t for c in tl.cues]\n    50\t        assert ts == sorted(ts), f\"{lang}: cues desordenados\"\n    51\t\n    52\t\n    53\tdef test_cada_subskill_esencial_puede_alcanzar_dominio(pack: Pack) -> None:\n    54\t    \"\"\"El criterio exige >=2 modalidades y, como el juez LLM aporta como mucho 1 de 3\n    55\t    evidencias, al menos 2 ítems deterministas por sub-skill.\"\"\"\n    56\t    necesarias = pack.dominio.aciertos_consecutivos - pack.dominio.max_evidencias_del_juez_llm\n    57\t    for s in pack.sub_skills:\n    58\t        if not s.esencial:\n    59\t            continue\n    60\t        mias = [q for q in pack.questions if q.subskill_primary == s.id]\n    61\t        assert len({q.modalidad for q in mias}) >= pack.dominio.modalidades_min, s.id\n    62\t        det = [q for q in mias if q.grader == \"deterministic\"]\n    63\t        assert len(det) >= necesarias, f\"{s.id}: {len(det)} deterministas, faltan {necesarias}\"\n    64\t\n    65\t\n    66\tdef test_todas_las_misconceptions_son_detectables_sin_llm(pack: Pack) -> None:\n    67\t    \"\"\"Hace viable la contingencia del PLAN R1: si el juez no pasa el gate, el\n    68\t    diagnóstico se apoya solo en ítems deterministas.\"\"\"\n    69\t    detectables = set()\n    70\t    for q in pack.questions:\n    71\t        if q.grader != \"deterministic\":\n    72\t            continue\n    73\t        detectables |= {o.misconception for o in (q.opciones or []) if o.misconception}\n    74\t        detectables |= {v for v in (q.diagnostico_si_falla or {}).values() if v}\n    75\t    faltan = {m.id for m in pack.misconceptions} - detectables\n    76\t    assert not faltan, f\"solo detectables con LLM: {sorted(faltan)}\"\n    77\t\n    78\t\n    79\tdef test_dominio_incoherente_es_rechazado() -> None:\n    80\t    with pytest.raises(ValueError, match=\"max_evidencias_del_juez_llm\"):\n    81\t        Dominio(aciertos_consecutivos=1, max_evidencias_del_juez_llm=2)\n    82\t    with pytest.raises(ValueError, match=\"sin_andamiaje_min\"):\n    83\t        Dominio(aciertos_consecutivos=2, sin_andamiaje_min=3)\n    84\t\n    85\t\n    86\t# ---- base de datos ---------------------------------------------------------\n    87\t\n    88\t@pytest.fixture()\n    89\tdef repo(tmp_path) -> Repo:\n    90\t    r = Repo(tmp_path / \"t.sqlite\")\n    91\t    yield r\n    92\t    r.close()\n    93\t\n    94\t\n    95\tdef test_sesion_y_eventos_append_only(repo: Repo) -> None:\n    96\t    sid = repo.create_session(concept_id=\"budget-line\", pack_version=\"0.1.0\", lang=\"es\")\n    97\t    repo.append_event(sid, \"cue.fired\", {\"id\": \"slope\"})\n    98\t    repo.set_phase(sid, \"delivery.checkpoint\")\n    99\t    evs = repo.events(sid)\n   100\t    assert [e[\"seq\"] for e in evs] == [1, 2, 3]\n   101\t    assert evs[0][\"type\"] == \"session.started\"\n   102\t    assert evs[-1][\"type\"] == \"phase.changed\"\n   103\t\n   104\t\n   105\tdef test_el_esquema_no_guarda_credenciales(repo: Repo) -> None:\n   106\t    \"\"\"C15: tutorIA nunca almacena passwords; solo reserva el mapeo al auth del destino.\"\"\"\n   107\t    cols = {r[\"name\"] for r in repo.conn.execute(\"PRAGMA table_info(students)\")}\n   108\t    assert \"external_auth_id\" in cols\n   109\t    assert not {c for c in cols if \"pass\" in c.lower() or \"hash\" in c.lower()}\n   110\t\n   111\t\n   112\t# ---- servidor --------------------------------------------------------------\n   113\t\n   114\t@pytest.fixture(scope=\"module\")\n   115\tdef client() -> TestClient:\n   116\t    from app.server.main import app\n   117\t    return TestClient(app)\n   118\t\n   119\t\n   120\tdef test_health(client: TestClient) -> None:\n   121\t    r = client.get(\"/api/health\")\n   122\t    assert r.status_code == 200\n   123\t    assert \"budget-line\" in r.json()[\"packs\"]\n   124\t\n   125\t\n   126\tdef test_crear_sesion_devuelve_media_y_checkpoints(client: TestClient) -> None:\n   127\t    r = client.post(\"/api/session\", json={\"concept_id\": \"budget-line\", \"lang\": \"es\"})\n   128\t    assert r.status_code == 200\n   129\t    body = r.json()\n   130\t    assert body[\"media\"][\"duration_s\"] > 0\n   131\t    assert len(body[\"checkpoints\"]) == 2\n   132\t    r2 = client.get(f\"/api/session/{body['session_id']}\")\n   133\t    assert r2.json()[\"phase\"] == \"delivery.playing\"\n   134\t\n   135\t\n   136\tdef test_idioma_inexistente_da_400(client: TestClient) -> None:\n   137\t    r = client.post(\"/api/session\", json={\"concept_id\": \"budget-line\", \"lang\": \"fr\"})\n   138\t    assert r.status_code == 422 or r.status_code == 400\n   139\t\n   140\t\n   141\tdef test_pack_inexistente_da_404(client: TestClient) -> None:\n   142\t    assert client.get(\"/api/packs/no-existe\").status_code == 404\napp/server/core/content/schema.py:12:from pydantic import BaseModel, Field, model_validator\napp/server/core/content/schema.py:19:class Localized(BaseModel):\napp/server/core/content/schema.py:27:class Ejemplo(BaseModel):\napp/server/core/content/schema.py:47:class SubSkill(BaseModel):\napp/server/core/content/schema.py:56:class Checkpoint(BaseModel):\napp/server/core/content/schema.py:62:class Dominio(BaseModel):\napp/server/core/content/schema.py:85:class Misconception(BaseModel):\napp/server/core/content/schema.py:97:class Opcion(BaseModel):\napp/server/core/content/schema.py:104:class Question(BaseModel):\napp/server/core/content/schema.py:143:class Cue(BaseModel):\napp/server/core/content/schema.py:150:class Timeline(BaseModel):\napp/server/core/content/schema.py:159:class Pack(BaseModel):\napp/server/main.py:12:from pydantic import BaseModel\napp/server/main.py:38:class NewSession(BaseModel):\napp/server/main.py:67:class AnswerIn(BaseModel):\napp/server/main.py:69:    valor: object\napp/server/main.py:108:class EventIn(BaseModel):\napp/server/core/judge/deterministic.py:166:def grade(q: Question, valor: Any, e: Ejemplo) -> Veredicto:\napp/server/core/__init__.py\napp/server/core/content/__init__.py\napp/server/core/content/loader.py\napp/server/core/content/schema.py\napp/server/core/judge/deterministic.py\napp/server/core/judge/__init__.py\napp/server/__init__.py\napp/server/db/__init__.py\napp/server/db/repo.py\napp/server/api/__init__.py\napp/server/main.py\n","exit_code":0,"status":"completed"}}
