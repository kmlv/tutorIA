span></span><span class=\\\"vlist-s\\\">​</span></span><span class=\\\"vlist-r\\\"><span class=\\\"vlist\\\" style=\\\"height:0.15em;\\\"><span></span></span></span></span></span></span></span></span><span style=\\\"top:-3.23em;\\\"><span class=\\\"pstrut\\\" style=\\\"height:3em;\\\"></span><span class=\\\"frac-line\\\" style=\\\"border-bottom-width:0.04em;\\\"></span></span><span style=\\\"top:-3.677em;\\\"><span class=\\\"pstrut\\\" style=\\\"height:3em;\\\"></span><span class=\\\"mord\\\"><span class=\\\"term\\\" data-term=\\\"m\\\"><span class=\\\"mord mathnormal\\\">m</span></span></span></span></span><span class=\\\"vlist-s\\\">​</span></span><span class=\\\"vlist-r\\\"><span class=\\\"vlist\\\" style=\\\"height:0.8804em;\\\"><span></span></span></span></span></span><span class=\\\"mclose nulldelimiter\\\"></span></span><span class=\\\"mspace\\\" style=\\\"margin-right:0.2778em;\\\"></span><span class=\\\"mrel\\\">=</span><span class=\\\"mspace\\\" style=\\\"margin-right:0.2778em;\\\"></span></span><span class=\\\"base\\\"><span class=\\\"strut\\\" style=\\\"height:1em;vertical-align:-0.25em;\\\"></span><span class=\\\"mord\\\">100</span><span class=\\\"mspace\\\"> </span><span class=\\\"mord text\\\"><span class=\\\"mord\\\">(unchanged)</span></span></span></span></span></span>\",\n    \"formulaDimHtml\": null\n  },\n  \"recap\": {\n    \"en\": \"Income shifts the line; a price pivots it around the other intercept.\",\n    \"es\": \"El ingreso desplaza la línea; un precio la gira sobre el otro intercepto.\",\n    \"formulaHtml\": null,\n    \"formulaDimHtml\": null\n  }\n};\n/* Desktop primero (decisión 15). Sin framework: el peso del bundle es criterio 5. */\n:root {\n  --bg:#fbfbf9; --fg:#22221f; --muted:#75756e; --line:#e4e4de; --card:#fff;\n  --accent:#0b5cff; --linea:#0b5cff; --fantasma:#b9b9b2; --conjunto:#0b5cff14;\n  --dock-w: 380px;\n}\n@media (prefers-color-scheme: dark) {\n  :root { --bg:#16161a; --fg:#e9e9e6; --muted:#98988f; --line:#2c2c32; --card:#1d1d21;\n          --accent:#82a8ff; --linea:#82a8ff; --fantasma:#4a4a52; --conjunto:#82a8ff1f; }\n}\n* { box-sizing:border-box; }\nbody { margin:0; background:var(--bg); color:var(--fg);\n  font:16px/1.6 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif; }\n\n#app { display:grid; grid-template-columns: 1fr var(--dock-w); min-height:100vh; }\nbody[data-dock=\"oculto\"] #app { grid-template-columns: 1fr 0; }\n\n.escenario { padding:1.5rem 1.75rem; transition:opacity .2s ease; }\nbody[data-dock=\"abierto-activo\"] .escenario { opacity:.55; }\n\n.titulo { font-size:1.3rem; margin:0 0 1rem; }\n.lienzo { max-width:620px; }\n.bgraph { width:100%; height:auto; display:block; }\n\n.eje { stroke:var(--muted); stroke-width:1.5; }\n.eje-label { fill:var(--muted); font-size:13px; }\n.recta { stroke:var(--linea); stroke-width:2.5; stroke-linecap:round;\n  transition:all .5s cubic-bezier(.4,0,.2,1); }\n.recta.punteada { stroke:var(--fantasma); stroke-width:2; stroke-dasharray:5 5; }\n.conjunto { fill:var(--conjunto); transition:all .5s cubic-bezier(.4,0,.2,1); }\n.punto { fill:var(--linea); transition:r .25s ease; }\n.punto.destacado { fill:var(--accent); }\n.valor { fill:var(--fg); font-size:13px; font-variant-numeric:tabular-nums; }\n.valor.destacado { fill:var(--accent); font-weight:600; }\n.triangulo { fill:none; stroke:var(--accent); stroke-width:2; }\n\n.controles { display:flex; align-items:center; gap:.6rem; margin-top:1rem; }\nbutton { font:inherit; font-size:.9rem; padding:.45rem .95rem; border-radius:8px;\n  border:1px solid var(--line); background:transparent; color:var(--fg); cursor:pointer; }\nbutton:hover { border-color:var(--accent); color:var(--accent); }\n.primario { background:var(--accent); border-color:var(--accent); color:#fff; }\n.primario:hover { color:#fff; opacity:.9; }\n.reloj { color:var(--muted); font-size:.85rem; font-variant-numeric:tabular-nums; }\n.desfase { color:var(--muted); font-size:.75rem; margin-left:auto; }\n\n.dock { border-left:1px solid var(--line); background:var(--card);\n  display:flex; flex-direction:column; overflow:hidden;\n  transition:opacity .18s ease; }\n.dock[data-estado=\"oculto\"] { opacity:0; pointer-events:none; }\n.dock-h { padding:.9rem 1rem; border-bottom:1px solid var(--line); }\n.dock-t { font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }\n.dock-body { flex:1; overflow-y:auto; padding:1rem; }\n.msg { margin:0 0 .8rem; padding:.6rem .8rem; border-radius:10px; font-size:.93rem; }\n.msg.tutor { background:var(--conjunto); }\n.msg.estudiante { background:transparent; border:1px solid var(--line); text-align:right; }\n.dock-acciones { display:flex; flex-wrap:wrap; gap:.4rem; padding:.8rem 1rem;\n  border-top:1px solid var(--line); }\n.intencion { font-size:.8rem; padding:.3rem .65rem; border-radius:999px; }\n\n@media (max-width: 900px) {\n  #app, body[data-dock=\"oculto\"] #app { grid-template-columns:1fr; }\n  .dock { border-left:none; border-top:1px solid var(--line); max-height:45vh; }\n}\n\n/* --- notes panel: text and formulas, not just the graph --------------------- */\n.cols { display:grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap:1.5rem;\n  align-items:start; }\n.notas { border-left:1px solid var(--line); padding-left:1.25rem; max-height:62vh;\n  overflow-y:auto; }\n.notas-h { font-size:.72rem; text-transform:uppercase; letter-spacing:.07em;\n  color:var(--muted); margin:.2rem 0 .9rem; font-weight:600; }\n.notas-lista { list-style:none; margin:0; padding:0; counter-reset:n; }\n.nota { padding:.55rem 0 .7rem; border-bottom:1px solid var(--line); }\n.nota:last-child { border-bottom:none; }\n.nota-txt { margin:0 0 .35rem; font-size:.92rem; line-height:1.5; }\n.nota-txt em { font-style:normal; font-weight:600; color:var(--accent); }\n.nota-f { overflow-x:auto; padding:.15rem 0; }\n.nota-f .katex-display { margin:.3rem 0; text-align:left; }\n.nota-f .katex { font-size:1em; }\n\n@media (max-width: 1100px) {\n  .cols { grid-template-columns:1fr; }\n  .notas { border-left:none; border-top:1px solid var(--line); padding-left:0;\n    padding-top:1rem; max-height:none; }\n}\n\n/* --- questions inside the dock --------------------------------------------- */\n.pregunta { margin:.6rem 0 1rem; padding:.8rem; border:1px solid var(--line);\n  border-radius:10px; background:var(--conjunto); }\n.q-enunciado { margin:0 0 .7rem; font-size:.94rem; font-weight:500; line-height:1.45; }\n.q-opciones { display:flex; flex-direction:column; gap:.4rem; }\n.q-opcion { text-align:left; font-size:.88rem; padding:.5rem .7rem; line-height:1.35; }\n.q-opcion.elegida { border-color:var(--accent); }\n.q-form { display:flex; flex-direction:column; gap:.5rem; }\n.q-label { display:flex; flex-direction:column; gap:.3rem; font-size:.8rem;\n  color:var(--muted); }\n.q-input, .q-textarea { font:inherit; font-size:.92rem; padding:.45rem .6rem;\n  border:1px solid var(--line); border-radius:8px; background:var(--bg);\n  color:var(--fg); width:100%; }\n.q-textarea { resize:vertical; }\n.q-input:focus, .q-textarea:focus { outline:2px solid var(--accent); outline-offset:1px; }\n.q-nota { margin:0; font-size:.85rem; color:var(--muted); font-style:italic; }\nbutton:disabled { opacity:.55; cursor:default; }\nbutton:disabled:hover { border-color:var(--line); color:var(--fg); }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"I’m choosing to embed `transcript` in each `timeline.<lang>.json`. That keeps audio, cue, language, and sentence timing as one versioned contract, avoids a second fetch and mismatch risk, and means the existing session response can serve captions once Claude adds one schema field. The caption component itself will remain independently testable and will accept note text only as a gap fallback."}}
