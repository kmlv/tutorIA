# Copy to `.env` and fill in. `.env` is in .gitignore and must never be committed.
#
#   cp .env.example .env
#   ${EDITOR:-nano} .env
#
# NEVER paste a key into a chat, an issue, a commit message or a screenshot. A key that
# has been in any of those is burned and has to be rotated, whoever saw it.
#
# Check it landed without printing it:
#   python -c "import os;k=os.environ.get('OPENAI_API_KEY','');print('len',len(k),'tail',k[-4:])"

# The LLM provider credential. Read only by the server process (decision 20); it never
# reaches the browser and is never written to the database. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: pin the key to one project/org.
# OPENAI_PROJECT=
# OPENAI_ORG_ID=

# Judge mode. `shadow` (default) runs the judge and records its verdicts without letting
# them count as evidence towards mastery. `live` additionally requires
# JUDGE_GATE_PASSED=1, which should only be set after a concordance report clears the
# M3 gate. `off` skips the model call entirely.
JUDGE_MODE=shadow
# JUDGE_GATE_PASSED=1

# SQLite file. Defaults to data/tutoria.sqlite.
# TUTORIA_DB=
