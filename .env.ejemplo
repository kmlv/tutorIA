# Copiar a `.env` EN EL SERVIDOR y rellenar. Nunca se sube a git.
#
# La clave del proveedor. Sin ella la lección funciona entera menos el chat del tutor.
OPENAI_API_KEY=

# Tope de gasto diario, en dólares. Al alcanzarlo el chat responde una frase y el resto
# de la lección sigue funcionando. Ponerlo a 0 lo desactiva; no lo hagas en algo público.
TUTORIA_LIMITE_USD_DIA=5

# El dominio o subdominio que apunta a este servidor, para que Caddy pida el certificado.
# Déjalo vacío o pon `:80` para servir por HTTP mientras no haya DNS.
DOMINIO=
